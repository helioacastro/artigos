	author = {Kendig, Catherine},
	title = {What Is Soil, and What Is It For? Social Ontologies and Social Epistemologies of Soil Affordances and Soil Experiments},
	year = {2025},
	journal = {International Library of Environmental, Agricultural and Food Ethics},
	volume = {37},
	pages = {17 – 38},
