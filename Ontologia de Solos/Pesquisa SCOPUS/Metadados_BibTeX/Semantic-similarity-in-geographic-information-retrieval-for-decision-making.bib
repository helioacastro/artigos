	author = {Machado, Neili and Balmaseda, Carlos and Montoyo, Andres},
	title = {Semantic similarity in geographic information retrieval for decision making; [Similitiud semántica en la recuperación de información geográfica para la toma de decisiones]},
	year = {2014},
	journal = {Iberian Conference on Information Systems and Technologies, CISTI},
